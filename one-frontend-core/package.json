{
  "name": "one-framework-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=one-frontend-core",
    "lint": "npm run lint --workspace=one-frontend-core",
    "typecheck": "npm run typecheck --workspace=one-frontend-core",
    "test": "npm run test --workspace=one-frontend-core",
    "build:all": "npm run build --workspaces --if-present",
    "lint:all": "npm run lint --workspaces --if-present",
    "test:all": "npm run test --workspaces --if-present"
  }
}
