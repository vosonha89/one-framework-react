{
  "name": "one-react-template",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Layered React 19 + Vite + TypeScript template with strict OOP, DI and View-Hook-State-Model pattern",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "npm run lint && npm run dev",
    "dev": "vite --mode development",
    "build:dev": "npm run lint && tsc -b && vite build --mode development",
    "build:uat": "npm run lint && tsc -b && vite build --mode uat",
    "build:prod": "npm run lint && tsc -b && vite build --mode production",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate": "plop",
    "init": "node scripts/init.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/validator": "^13.15.10",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.4",
    "eslint-plugin-jsdoc": "^65.5.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "plop": "^4.0.5",
    "sass-embedded": "^1.108.2",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "handlebars": "^4.7.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true
  }
}
